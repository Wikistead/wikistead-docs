// Cloudflare Workers static-assets config: the git-connected build runs `pnpm build` and then
// `npx wrangler deploy`, which serves ./dist as static assets. No Worker script — assets only.
// preview_urls stays off: a preview is a public URL regardless of repository visibility.
{
  "name": "ws-docs-5df8",
  "compatibility_date": "2026-08-01",
  "preview_urls": false,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page"
  }
}
